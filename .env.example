# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Backend ---
# App environment: development | production
CRIP_ENV=development
# SQLAlchemy database URL. SQLite for local dev; swap for a Postgres URL in prod.
CRIP_DATABASE_URL=sqlite:///./crip.db
# Log level: DEBUG | INFO | WARNING | ERROR
CRIP_LOG_LEVEL=INFO
# Comma-separated allowed CORS origins for the frontend.
CRIP_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Base URL the browser uses to reach the backend (client-side fetches).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Base URL used for server-side/proxy fetches (in-container: http://backend:8000).
API_BASE_URL=http://localhost:8000
